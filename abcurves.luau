					self.coeff[k * 2 + 2] = along * axis_y + across * axis_x
				end
				self.hold_goal_x, self.hold_goal_y = goal_x, goal_y
				self.hold_error = raw[1]
				self.changed = false
				self.innov_at = 0 / 0
			end
		elseif old == 2 then
			if innovation and known then
